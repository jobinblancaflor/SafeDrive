# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Firebase Admin (FCM) — server-side, requires Service Account JSON
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Local JSON kept OUTSIDE repo at: F:\Development\.secrets\<project>-firebase-adminsdk-*.json
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@YOUR_PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Anthropic (chat widget) — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Used to build absolute email redirect links (invite/reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mailchimp (footer newsletter signup)
# API key format is "<key>-<server-prefix>", e.g. "abc123...-us21" — the
# server prefix is parsed from it automatically, no separate var needed.
# Audience ID is the list ID under Audience → Settings → Audience name and defaults.
MAILCHIMP_API_KEY=YOUR_KEY-usXX
MAILCHIMP_AUDIENCE_ID=YOUR_AUDIENCE_ID

# Shared secret the mobile app sends as the X-Device-Key header on every
# device-facing endpoint (incident report/log, device register, ping ack).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_API_KEY=YOUR_LONG_RANDOM_SECRET
